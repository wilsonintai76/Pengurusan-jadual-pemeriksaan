{
  "name": "portal-pemeriksaan-aset-poliku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "deploy": "node scripts/deploy.mjs",
    "deploy:frontend": "node scripts/deploy.mjs --frontend-only",
    "deploy:backend": "node scripts/deploy.mjs --backend-only",
    "worker:dev": "wrangler dev --config backend/wrangler.jsonc",
    "worker:deploy": "node scripts/deploy.mjs --backend-only",
    "d1:migrate": "wrangler d1 execute poliku-aset-d1 --remote --config backend/wrangler.jsonc --file=backend/schema.sql",
    "d1:migrate:local": "wrangler d1 execute poliku-aset-d1 --local --config backend/wrangler.jsonc --file=backend/schema.sql"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.553.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.2.1",
    "unpdf": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
