# ==============================================================================
# Cloudflare Workers AI & Backend Configuration (Free Tier Compatible)
# ==============================================================================

# Cloudflare Account ID & API Token (Required if accessing Workers AI REST endpoint directly)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# Hono Cloudflare Worker Backend URL (Local dev: http://localhost:8787 or production worker)
VITE_API_URL="http://localhost:8787"
CLOUDFLARE_WORKER_URL="http://localhost:8787"

# Base Application URL
APP_URL="http://localhost:3000"

# Worker authentication (used by `wrangler dev` via backend/.dev.vars — min 16 chars)
JWT_SECRET="replace_with_a_long_random_secret"
AUTH_ITERATIONS="25000"

