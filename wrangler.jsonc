{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-aset-poliku",
  "compatibility_date": "2026-10-28",

  // SPA static assets built by Vite into ./dist
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
